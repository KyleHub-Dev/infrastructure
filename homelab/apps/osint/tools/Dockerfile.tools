FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    gcc \
    libxml2-dev \
    libxslt-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Username enumeration
RUN pip install --no-cache-dir maigret
RUN pip install --no-cache-dir sherlock-project

# Email-to-account discovery
RUN pip install --no-cache-dir holehe

# Instagram intelligence
RUN pip install --no-cache-dir toutatis

# Dark Web search (kept from original)
RUN pip install --no-cache-dir onionsearch

# Create reports directory
RUN mkdir -p /app/reports

CMD ["/bin/bash"]
