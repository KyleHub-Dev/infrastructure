# =====================================================================
# homelab/core/storage — Environment variables
# =====================================================================
# Copy this file to .env and fill in the values below.
# NEVER commit .env to version control.
# =====================================================================

# ---- Public/admin hostnames ----
# Console hostname routed by Pangolin to rustfs:9001.
RUSTFS_CONSOLE_DOMAIN=storage.kylehub.dev
# Optional external S3 hostname routed by Pangolin to rustfs:9000.
RUSTFS_S3_DOMAIN=s3.kylehub.dev
# Hostnames RustFS should recognize when generating URLs.
RUSTFS_SERVER_DOMAINS=storage.kylehub.dev,s3.kylehub.dev

# ---- Persistent object data path on the homelab host ----
RUSTFS_DATA_DIR=/srv/rustfs/data

# ---- Root/admin S3 credentials ----
# Generate with:
#   openssl rand -hex 16
#   openssl rand -base64 48
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me-long-random-secret

# ---- RustFS logging ----
RUSTFS_OBS_LOGGER_LEVEL=info

# ---- Pangolin / NEWT tunnel ----
PANGOLIN_ENDPOINT=https://pangolin.kylehub.dev
NEWT_ID=change-me
NEWT_SECRET=change-me
