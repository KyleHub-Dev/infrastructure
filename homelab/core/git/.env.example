# =====================================================================
# homelab/core/git - Environment variables
# =====================================================================
# This stack is prepared but NOT deployed. See SETUP.md (Status).
#
# Pangolin / NEWT credentials are NOT defined here - the central Newt
# lives in homelab/core/_edge and serves all core/* stacks.
# =====================================================================

# Public instance URL
FORGEJO_DOMAIN=git.kylehub.dev
FORGEJO_ROOT_URL=https://git.kylehub.dev/
FORGEJO_SSH_DOMAIN=git.kylehub.dev
FORGEJO_SSH_PORT=2222
FORGEJO_APP_NAME=KyleHub Git

# Container user used by the Forgejo rootless image
FORGEJO_UID=1000
FORGEJO_GID=1000

# Initial bootstrap posture:
# Keep registration open only until your first account is created.
# The first registered user becomes the site administrator.
FORGEJO_DISABLE_REGISTRATION=false
FORGEJO_REQUIRE_SIGNIN_VIEW=false
FORGEJO_REGISTER_EMAIL_CONFIRM=false
FORGEJO_ALLOW_ONLY_EXTERNAL_REGISTRATION=false

# Repository defaults
FORGEJO_DEFAULT_PRIVATE=last
FORGEJO_ENABLE_PUSH_CREATE_USER=true
FORGEJO_ENABLE_PUSH_CREATE_ORG=true

# UI themes
FORGEJO_DEFAULT_THEME=forgejo-auto

# Database
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=
