# =====================================================================
# homelab/core/langfuse - Environment variables
# =====================================================================
# Copy this file to .env and fill in the values below.
# NEVER commit .env to version control.
#
# Required secrets have NO default in compose - the stack will fail
# to start if they are unset, by design.
# =====================================================================

# ---- Public URL (Pangolin Resource) ----
NEXTAUTH_URL=https://langfuse.kylehub.dev

# ---- Required secrets ----
# Generate fresh values:
#   NEXTAUTH_SECRET, SALT     -> openssl rand -hex 32
#   ENCRYPTION_KEY            -> openssl rand -hex 32   (must be 64 hex chars)
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

# ---- Postgres (langfuse-postgres) ----
# Pin to a Langfuse-supported major. v3 self-host examples use 16.
POSTGRES_VERSION=16
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=
POSTGRES_DB=langfuse

# ---- ClickHouse (langfuse-clickhouse) ----
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=

# ---- Redis (langfuse-redis) ----
# AOF + RDB persistence is enabled in compose; queue state survives a
# restart. Still pick a strong password - Redis listens on the
# stack-private network only, but defence in depth.
REDIS_AUTH=

# ---- Object storage = central RustFS (homelab/core/storage) ----
# Create a dedicated bucket and ACCESS KEY PAIR in RustFS first:
#   1. Bring up storage/, log into the RustFS console.
#   2. Create bucket "langfuse" (or whatever you set below).
#   3. Create a service account / access key pair scoped to that bucket.
#   4. Paste the keys here. Do NOT reuse the RustFS root credentials.
LANGFUSE_S3_ENDPOINT=http://storage-rustfs:9000
LANGFUSE_S3_REGION=auto
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_ACCESS_KEY_ID=
LANGFUSE_S3_SECRET_ACCESS_KEY=

# Browser-facing endpoint for presigned URLs (media uploads, batch
# exports). Leave blank until you create the optional Pangolin Resource
# `s3.kylehub.dev -> storage-rustfs:9000` (no IAP). Without it, media
# upload via the Langfuse UI will not work because browsers cannot
# resolve the internal endpoint above.
LANGFUSE_S3_EXTERNAL_ENDPOINT=

# Batch export is disabled by default. Enable once external endpoint
# is in place.
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false

# ---- Telemetry / features ----
TELEMETRY_ENABLED=true
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# ---- SMTP (optional) ----
EMAIL_FROM_ADDRESS=
SMTP_CONNECTION_URL=

# ---- Custom OIDC (optional, leave blank for Phase-1 IAP-only setup) ----
# Use these later if you wire Langfuse's NextAuth directly to Zitadel
# instead of relying on Pangolin IAP in front. Out of scope for Phase 1.
AUTH_CUSTOM_ID=
AUTH_CUSTOM_NAME=
AUTH_CUSTOM_ISSUER=
AUTH_CUSTOM_CLIENT_ID=
AUTH_CUSTOM_CLIENT_SECRET=
AUTH_CUSTOM_SCOPE=openid email profile
