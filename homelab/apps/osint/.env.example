# ============================================================
# OSINT Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Pangolin / NEWT Tunnel ---
PANGOLIN_ENDPOINT=https://pangolin.yourdomain.com
NEWT_ID=
NEWT_SECRET=

# --- Neo4j ---
NEO4J_AUTH=neo4j/changeme-use-a-strong-password
NEO4J_URI=bolt://osint-neo4j:7687

# --- Meilisearch ---
MEILI_MASTER_KEY=change-me-to-a-strong-key

# --- Redis (Celery broker) ---
REDIS_URL=redis://osint-redis:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Trusted header name from Pangolin IAP
AUTH_HEADER=Remote-User

# --- GDPR Compliance ---
# Default data retention period in days (365 = 1 year)
DEFAULT_TTL_DAYS=365

# --- Demo Seed ---
# User for the seeded demo investigation (should match your Pangolin auth user)
SEED_USER=your-email@example.com

# --- Tor Proxy ---
TOR_SOCKS_PROXY=socks5://osint-tor:9050
