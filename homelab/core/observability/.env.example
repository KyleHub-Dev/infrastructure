# =====================================================================
# homelab/core/observability - Environment variables
# =====================================================================
# Copy this file to .env and fill in the values below.
# NEVER commit .env to version control.
# =====================================================================

# Environment label injected into telemetry as deployment.environment.
ENVIRONMENT=production

# ---- Grafana initial admin ----
# Required. The compose intentionally has no defaults - the stack will
# fail to start if these are unset.
# Generate with:  openssl rand -base64 32
GRAFANA_USER=
GRAFANA_PASSWORD=

# ---- Grafana public URL (Pangolin Resource) ----
GRAFANA_ROOT_URL=https://grafana.kylehub.dev
