# =====================================================================
# homelab/core/dns - Environment variables
# =====================================================================
# Copy this file to .env and fill in the values below.
# NEVER commit .env to version control.
#
# Pangolin / NEWT credentials are NOT defined here - the central Newt
# lives in homelab/core/_edge and serves all core/* stacks.
# =====================================================================

# ---- TLS / ACME (Let's Encrypt via Cloudflare DNS-01) ----
# Comma-separated list of hostnames to include in the certificate.
# The FIRST entry is the "primary" - lego names cert files after it
# and AdGuard's TLS server_name should match it.
#
# Default includes a wildcard for *.dns.kylehub.dev so AdGuard's
# ClientID-via-SNI feature works (each device uses a unique
# subdomain like phone-kyle.dns.kylehub.dev). If you don't need
# per-device client identifiers, you can drop the wildcard.
#
# Cloudflare A-record for the primary name MUST point at this server's
# public IPv4 with proxy OFF (see SETUP.md). The wildcard does not
# need its own A-record - clients send the leaf name as SNI; the
# Cloudflare-side resolution is via the apex.
CERT_DOMAINS=dns.kylehub.dev,*.dns.kylehub.dev

# Email used by Let's Encrypt for ACME account registration and
# expiry notifications.
ACME_EMAIL=

# Cloudflare API token with Zone:DNS:Edit on the kylehub.dev zone.
# (The same token gateway-vps' Traefik uses is fine, provided its
# Client-IP-Filtering allows this server's public IPv4.)
CF_DNS_API_TOKEN=

# ---- Podman API socket (for cert auto-reload via renew-hook) ----
# After lego renews the cert, the renew-hook calls back to Podman to
# restart dns-adguard so it picks up the new TLS material. Pick the
# socket path that matches your runtime:
#
#   Rootless Podman (recommended):
#     /run/user/<UID>/podman/podman.sock
#     Verify your UID with: id -u
#     Prereq: `systemctl --user enable --now podman.socket`
#             `sudo loginctl enable-linger $USER`
#
#   Rootful Podman:
#     /run/podman/podman.sock
#
PODMAN_SOCKET=/run/user/1000/podman/podman.sock

# ---- AdGuard admin API (used by scripts/add-client.sh, etc.) ----
# Same credentials you set in the AdGuard first-run wizard.
# Only needed when running the helper scripts; the running stack
# does not consume these.
ADGUARD_URL=http://127.0.0.1:3000
ADGUARD_USER=
ADGUARD_PASS=

# ---- Misc ----
TZ=Europe/Berlin
