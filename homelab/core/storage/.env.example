# =====================================================================
# homelab/core/storage - Environment variables
# =====================================================================
# Copy this file to .env and fill in the values below.
# NEVER commit .env to version control.
#
# Pangolin / NEWT credentials are NOT defined here - the central Newt
# lives in homelab/core/_edge and serves all core/* stacks.
# =====================================================================

# ---- Public/admin hostnames ----
# Hostnames RustFS should recognise when generating URLs.
RUSTFS_SERVER_DOMAINS=storage.kylehub.dev,s3.kylehub.dev

# ---- Persistent object data path on the host ----
RUSTFS_DATA_DIR=/srv/rustfs/data

# ---- Root/admin S3 credentials ----
# Generate with:
#   openssl rand -hex 16
#   openssl rand -base64 48
# Use these only for initial setup and creating per-stack service
# accounts. Never embed the root credentials in consuming apps.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ---- RustFS logging ----
RUSTFS_OBS_LOGGER_LEVEL=info
