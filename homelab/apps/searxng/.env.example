# =============================================================================
# SearXNG — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# SearXNG
# -----------------------------------------------------------------------------

# Public hostname Pangolin will expose this service on (no https://)
SEARXNG_HOSTNAME=search.example.com

# Secret key for SearXNG session signing — generate with:
#   openssl rand -hex 32
SEARXNG_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32

# uWSGI worker/thread tuning (scale with your host CPU count)
UWSGI_WORKERS=4
UWSGI_THREADS=4

# -----------------------------------------------------------------------------
# Newt tunnel (Pangolin)
# -----------------------------------------------------------------------------

# Your Pangolin server hostname (no https://)
PANGOLIN_ENDPOINT=pangolin.example.com

# Tunnel credentials — create a new tunnel in the Pangolin dashboard,
# then copy the ID and secret here.
NEWT_TUNNEL_ID=
NEWT_TUNNEL_SECRET=
