# ==============================================================================
# Pelican Panel Configuration
# ==============================================================================

# The URL of your panel (e.g., https://pelican.kylehub.dev)
# This should match the domain configured in your Pangolin Gateway.
APP_URL=https://pelican.example.com
APP_ENV=production
APP_DEBUG=false

# The email address for the initial admin account and Let's Encrypt (if used)
ADMIN_EMAIL=admin@example.com

# ==============================================================================
# Database Configuration (MariaDB)
# ==============================================================================
DB_HOST=pelican-db
DB_PORT=3306
DB_DATABASE=pelican
DB_USERNAME=pelican
# Generate a secure password: openssl rand -base64 24
DB_PASSWORD=

# Root password for the MariaDB container
MYSQL_ROOT_PASSWORD=

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_HOST=pelican-cache
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ==============================================================================
# Mail Configuration (Optional)
# ==============================================================================
# For initial setup, "log" is easiest. Change to "smtp" for production.
MAIL_DRIVER=log
MAIL_FROM=noreply@example.com

# ==============================================================================
# Pangolin NEWT Configuration
# ==============================================================================
# The URL of your Pangolin Gateway
PANGOLIN_SERVER=https://pangolin.example.com

# NEWT credentials from your Pangolin Dashboard (Sites -> Your Site -> NEWT)
NEWT_ID=
NEWT_SECRET=

# ==============================================================================
# Advanced Pelican Settings
# ==============================================================================
# Set to true since we are behind the Pangolin/Traefik reverse proxy
BEHIND_PROXY=true
# Internal Docker/Podman network range
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# Keep Caddy running internally to serve HTTP (SSL is handled by the Gateway)
SKIP_CADDY=false

# ==============================================================================
# Wings (Node) Coordination
# ==============================================================================
# If Wings is on the same host, it will connect to the Panel via APP_URL.
# Ensure your Gateway VPS allows the dedicated server's IP to access APP_URL.
# If SKIP_CADDY=false, Caddy will run on port 80 internally.
# If SKIP_CADDY=true, you must ensure PHP-FPM is reachable or use a different image.
