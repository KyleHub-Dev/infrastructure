# =====================================================================
# homelab/core/_edge - Pangolin/Newt agent credentials
# =====================================================================
# Copy this file to .env and fill in the values below.
# NEVER commit .env to version control.
#
# Provision NEWT_ID and NEWT_SECRET ONCE for the entire core zone:
#   Pangolin admin -> Sites -> New Site -> name "Homelab Core"
# Pangolin generates the ID and secret. Store both in your password
# manager. Use this single Newt for every core/* stack; do not create
# per-stack Newts.
# =====================================================================

PANGOLIN_ENDPOINT=https://pangolin.kylehub.dev
NEWT_ID=
NEWT_SECRET=
