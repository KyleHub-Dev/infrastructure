# =====================================================================
# homelab/core/dns — Environment variables
# =====================================================================
# Copy this file to .env and fill in the values below.
# NEVER commit .env to version control.
# =====================================================================

# ---- Pangolin / NEWT tunnel (dashboard access) ----
# Endpoint where Pangolin's gerbil agent is reachable.
PANGOLIN_ENDPOINT=https://pangolin.kylehub.dev
# NEWT credentials provisioned for the AdGuard dashboard resource in
# Pangolin. See gateway-vps Pangolin admin → Resources → New.
NEWT_ID=
NEWT_SECRET=

# ---- TLS / ACME (Let's Encrypt via Cloudflare DNS-01) ----
# Public hostname mobile devices and routers will resolve via.
# Cloudflare A-record for this name MUST point at this server's
# public IPv4 with proxy OFF (see SETUP.md).
CERT_DOMAIN=dns.kylehub.dev
# Email used by Let's Encrypt for expiry notifications.
ACME_EMAIL=
# Cloudflare API token with Zone:DNS:Edit on the kylehub.dev zone.
# (Same scope as gateway-vps' CF_DNS_API_TOKEN — can be the same token.)
CF_DNS_API_TOKEN=

# ---- LAN binding for plain DNS (port 53) ----
# IPv4 of the host's LAN interface. Plain DNS (port 53) is bound ONLY
# to this address so the box does not act as a public open resolver.
# Find with:  ip -4 addr show | awk '/inet 192\.168/{print $2}'
LAN_IP=192.168.1.10

# ---- Misc ----
TZ=Europe/Berlin
